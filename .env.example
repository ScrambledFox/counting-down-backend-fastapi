APP_ENV="dev"
# "text" (default) or "json" (one object per line, used on Lambda for metric filters).
LOG_FORMAT="text"
MONGO_URL="mongodb+srv://countdown:"
MONGO_APP_NAME="something"
# Connections per process; keep small (e.g. 5) for serverless functions.
MONGO_MAX_POOL_SIZE="100"
# Set to false when scripts/ensure_indexes.py runs at deploy time.
ENSURE_INDEXES_ON_STARTUP="true"
RELATIONSHIP_PROFILE_COLLECTION_NAME="relationship_profile"

FRONTEND_URL="https://website.com/"

# Optional. Leave both unset to use the AWS default credential chain (IAM role, AWS_PROFILE).
AWS_ACCESS_KEY="your_access_key_id"
AWS_SECRET_KEY="your_secret_access_key"
AWS_S3_BUCKET="your_bucket_name"
AWS_REGION="eu-west-1"
# Region of the S3 bucket. Required on Lambda, where AWS_REGION is the function's region.
AWS_S3_REGION=""

ACCESS_KEY_DANFENG="danfeng_secret_key"
ACCESS_KEY_JORIS="joris_secret_key"

OPENAI_API_KEY=""
OPENAI_MODEL_MEDIATION="gpt-5"
OPENAI_MODEL_MODERATION="omni-moderation-latest"
OPENAI_MODEL_XIAOBAO="gpt-5.6-terra"
XIAOBAO_REASONING_EFFORT="low"
XIAOBAO_MAX_OUTPUT_TOKENS="1200"
XIAOBAO_HISTORY_MESSAGE_LIMIT="20"
XIAOBAO_HISTORY_CHARACTER_LIMIT="20000"
XIAOBAO_MEDIATION_SESSION_LIMIT="10"
XIAOBAO_MEDIATION_COMMENT_LIMIT="20"
XIAOBAO_MEDIATION_CONTEXT_CHARACTER_LIMIT="30000"
XIAOBAO_MEDIATION_PRIVATE_CONTEXT_CHARACTER_LIMIT="15000"
XIAOBAO_RATE_LIMIT_REQUESTS="10"
XIAOBAO_RATE_LIMIT_WINDOW_SECONDS="300"
XIAOBAO_CHECKPOINT_TTL_SECONDS="604800"
XIAOBAO_ROUTINE_CLOCK_POLL_INTERVAL_SECONDS="15"
XIAOBAO_ROUTINE_WORKER_POLL_INTERVAL_SECONDS="2"
XIAOBAO_ROUTINE_LEASE_SECONDS="300"
XIAOBAO_ROUTINE_MAX_ATTEMPTS="3"
XIAOBAO_ROUTINE_RETRY_BASE_SECONDS="30"
XIAOBAO_ROUTINE_RETRY_MAX_SECONDS="900"
XIAOBAO_ROUTINE_MATERIALIZE_BATCH_SIZE="50"
XIAOBAO_WEB_PUSH_ENABLED="false"
XIAOBAO_WEB_PUSH_VAPID_PUBLIC_KEY=""
XIAOBAO_WEB_PUSH_VAPID_PRIVATE_KEY=""
XIAOBAO_WEB_PUSH_VAPID_SUBJECT="mailto:admin@example.com"
XIAOBAO_WEB_PUSH_SUBSCRIPTION_ENCRYPTION_KEY=""
XIAOBAO_WEB_PUSH_WORKER_POLL_INTERVAL_SECONDS="2"
XIAOBAO_WEB_PUSH_LEASE_SECONDS="60"
XIAOBAO_WEB_PUSH_MAX_ATTEMPTS="3"
XIAOBAO_WEB_PUSH_RETRY_BASE_SECONDS="30"
XIAOBAO_WEB_PUSH_RETRY_MAX_SECONDS="900"
XIAOBAO_WEB_PUSH_TTL_SECONDS="300"
MEDIATION_WORKER_ENABLED="false"
# Background jobs inside the web process (image jobs are on by default).
IMAGE_WORKER_ENABLED="true"
XIAOBAO_IN_PROCESS_JOBS_ENABLED="false"
# How the API signals the job runner after creating work: "none" or "lambda".
JOB_WAKEUP_MODE="none"
JOB_WAKEUP_LAMBDA_FUNCTION_NAME=""
# Region of the jobs function (defaults to AWS_REGION).
JOB_WAKEUP_LAMBDA_REGION=""
# Optional invoke-only credentials for the wake-up, separate from the S3 keys (both or neither).
JOB_WAKEUP_AWS_ACCESS_KEY=""
JOB_WAKEUP_AWS_SECRET_KEY=""
MEDIATION_JOB_PROCESSING_TIMEOUT_SECONDS="300"

# AeroDataBox flight metadata lookup (via RapidAPI)
# Required for the "Lookup flight" feature in the flight creation form.
# Subscribe at https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_API_KEY=""
AERODATABOX_BASE_URL="https://aerodatabox.p.rapidapi.com"
AERODATABOX_API_HOST="aerodatabox.p.rapidapi.com"
AERODATABOX_TIMEOUT_SECONDS="10.0"
AERODATABOX_LOOKUP_WINDOW_DAYS="7"
AERODATABOX_CACHE_TTL_SUCCESS_SECONDS="21600"
AERODATABOX_CACHE_TTL_NO_RESULTS_SECONDS="1800"
